{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "eraser": {
      "type": "http",
      "url": "https://app.eraser.io/api/mcp"
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp"
    },
    "excalidraw": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-excalidraw-server"
      ],
      "env": {
        "PORT": "3999",
        "EXPRESS_SERVER_URL": "http://127.0.0.1:3999"
      }
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "rea-agents@6.4.0",
        "mcp"
      ],
      "env": {
        "GHIDRA_INSTALL_DIR": "/path/to/ghidra_install_dir",
        "HOPPER_LAUNCHER_PATH": "/path/to/hopper_launcher_path",
        "JAVA_HOME": "/path/to/java_home"
      }
    },
    "invisimcp": {
      "type": "stdio",
      "command": "/path/to/python",
      "args": [
        "/path/to/invisimcp/server.py"
      ]
    }
  }
}
